  "fakta": [
    {
      "pastaende": "2025 fanns cirka 420 000 FWA-abonnemang i Sverige, alltså mobilt bredband som säljs till en fast adress. Antalet växte med över 20 procent under 2025 och med nära 60 procent jämfört med 2022.",
      "kalla": "https://www.pts.se/contentassets/9f77870e1a904af1978495986b9a227c/slutversion-rapport-svensk-telekommarknad-2025-dnr-2516551_t.pdf"
    },
    {
      "pastaende": "Antalet FWA-abonnemang var 265 000 år 2022, 288 000 år 2023, 347 000 år 2024 och 419 000 år 2025 (PTS, Svensk telekommarknad 2025, tabell 9).",
      "kalla": "https://www.pts.se/contentassets/9f77870e1a904af1978495986b9a227c/slutversion-rapport-svensk-telekommarknad-2025-dnr-2516551_t.pdf"
    },
    {
      "pastaende": "Abonnemang med endast data, där FWA ingår, ökade med nära 8 procent 2025 till strax över 1,6 miljoner.",
      "kalla": "https://www.pts.se/contentassets/9f77870e1a904af1978495986b9a227c/slutversion-rapport-svensk-telekommarknad-2025-dnr-2516551_t.pdf"
    },
    {
      "pastaende": "Ett FWA-abonnemang använde i genomsnitt 374 GB per månad 2025, mot 82 GB för övriga abonnemang med endast data.",
      "kalla": "https://www.pts.se/contentassets/9f77870e1a904af1978495986b9a227c/slutversion-rapport-svensk-telekommarknad-2025-dnr-2516551_t.pdf"
    },
    {
      "pastaende": "FWA-abonnemangen stod för cirka 1 900 petabyte 2025, drygt en tredjedel av all mobil datatrafik i Sverige.",
      "kalla": "https://www.pts.se/contentassets/9f77870e1a904af1978495986b9a227c/slutversion-rapport-svensk-telekommarknad-2025-dnr-2516551_t.pdf"
    },
    {
      "pastaende": "PTS konstaterar att FWA ökade tydligt under 2025 och står för en liten andel av den fasta bredbandsmarknaden.",
      "kalla": "https://via.tt.se/pressmeddelande/4398476/allt-vanligare-med-5g-och-hogre-hastigheter-for-fast-bredband"
    }
  ]
